# deploy/wmux.service.example 的 EnvironmentFile 指向 ~/.config/wmux/wmux.env。
# 把这个文件复制过去后按需取消注释；每个变量的默认值和含义见 README.md 的“配置”表格。
# systemd unit 里已经用 Environment= 设过 WMUX_HOST / WMUX_PORT / WMUX_DATA_DIR，
# 在这里重复设置会覆盖它们。EnvironmentFile 不展开 %h、$HOME 之类的占位符，路径必须写成绝对路径。

# WMUX_HOST=127.0.0.1
# WMUX_PORT=8787
# WMUX_DATA_DIR=/home/alice/.local/share/wmux
# WMUX_PUBLIC_URL=https://terminal.example.com
# WMUX_COOKIE_SECURE=true
# WMUX_TRUST_PROXY=true
# WMUX_SESSION_TTL=168h
# WMUX_LOG_LEVEL=info
# WMUX_SSH_CONFIG=/home/alice/.ssh/config
